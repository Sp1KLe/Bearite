{
  "id": "sba-zoom",
  "name": "Зум",
  "version": "1.2",
  "author": "Bearite",
  "description": "Приближает камеру игры. Кнопка «Зум» на экране включает приближение, «+» и «−» меняют силу. Ползунки «Центр по X/Y» выбирают, в какую точку экрана приближает.",
  "libs": [
    "libs/arm64-v8a/libsbazoom.so"
  ],
  "settings": [
    {
      "id": "zoom_on",
      "type": "bool",
      "name": "Зум включён",
      "description": "Включи, чтобы приблизить камеру",
      "default": false
    },
    {
      "id": "zoom_amount",
      "type": "float",
      "name": "Сила зума",
      "description": "Во сколько раз приближается картинка",
      "min": 1.2,
      "max": 5,
      "default": 2,
      "control": "slider"
    },
    {
      "id": "smooth",
      "type": "float",
      "name": "Плавность",
      "description": "Чем больше, тем быстрее приближение",
      "min": 1,
      "max": 20,
      "default": 8,
      "control": "slider"
    },
    {
      "id": "focus_x",
      "type": "float",
      "name": "Центр зума по X",
      "description": "−1 слева, 0 центр экрана, 1 справа",
      "min": -1,
      "max": 1,
      "default": 0,
      "control": "slider"
    },
    {
      "id": "focus_y",
      "type": "float",
      "name": "Центр зума по Y",
      "description": "−1 снизу, 0 центр экрана, 1 сверху",
      "min": -1,
      "max": 1,
      "default": 0,
      "control": "slider"
    },
    {
      "id": "invert",
      "type": "bool",
      "name": "Инвертировать смещение",
      "description": "Включи, если центр зума смещается в обратную сторону",
      "default": false
    }
  ],
  "hud": [
    {
      "label": "Зум",
      "setting": "zoom_on",
      "action": "toggle",
      "pos": "left"
    },
    {
      "label": "+",
      "setting": "zoom_amount",
      "action": "step",
      "step": 0.5,
      "pos": "left"
    },
    {
      "label": "−",
      "setting": "zoom_amount",
      "action": "step",
      "step": -0.5,
      "pos": "left"
    }
  ]
}
