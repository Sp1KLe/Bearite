{
  "id": "sba-zoom",
  "name": "Зум",
  "version": "1.1",
  "author": "Тимур",
  "description": "Приближает камеру игры. Кнопки Зум, + и - на экране",
  "libs": [ "libs/arm64-v8a/libsbazoom.so" ],
  "settings": [
    {
      "id": "zoom_on",
      "type": "bool",
      "name": "Зум включён",
      "description": "Включает приближение камеры",
      "default": false
    },
    {
      "id": "zoom_amount",
      "type": "float",
      "name": "Сила зума",
      "description": "Во сколько раз приближается картинка",
      "min": 1.2,
      "max": 5,
      "default": 2,
      "control": "slider"
    },
    {
      "id": "smooth",
      "type": "float",
      "name": "Плавность",
      "description": "Чем больше, тем быстрее приближение",
      "min": 1,
      "max": 20,
      "default": 8,
      "control": "slider"
    }
  ],
  "hud": [
    { "label": "Зум", "setting": "zoom_on", "action": "toggle", "pos": "right" },
    { "label": "+", "setting": "zoom_amount", "action": "step", "step": 0.5, "pos": "right" },
    { "label": "-", "setting": "zoom_amount", "action": "step", "step": -0.5, "pos": "right" }
  ]
}
