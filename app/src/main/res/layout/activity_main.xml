<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true">

    <com.bearite.patcher.DesignFrame
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- мягкие засветы на фоне -->
    <View
        android:layout_width="520dp"
        android:layout_height="520dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-220dp"
        android:layout_marginTop="-260dp"
        android:alpha="0.75"
        android:background="@drawable/bg_flare" />

    <View
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-230dp"
        android:layout_marginEnd="-120dp"
        android:alpha="0.6"
        android:background="@drawable/bg_flare" />

    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="center"
        android:alpha="0.55"
        android:background="@drawable/bg_flare" />

    <ImageView
        android:id="@+id/bg_spark1"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="86dp"
        android:layout_marginEnd="210dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_sparkle" />

    <ImageView
        android:id="@+id/bg_spark2"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="120dp"
        android:layout_marginBottom="80dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_sparkle" />

    <!-- мягкие круги в правом нижнем углу, как в макете -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-70dp"
        android:layout_marginBottom="-150dp"
        android:alpha="0.9"
        android:background="@drawable/bg_blob" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="150dp"
        android:layout_marginBottom="-140dp"
        android:background="@drawable/bg_blob2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- шапка: иконка, название, метка и версия -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="@null"
                android:src="@drawable/bear_hero" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/app_name"
                android:textColor="@color/bear_cream"
                android:textSize="24sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@color/bear_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_dot" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.1"
                    android:text="FAN-MADE LAUNCHER"
                    android:textColor="@color/bear_tan"
                    android:textSize="10sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/header_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/bear_tan"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- вертикальная панель вкладок -->
            <ScrollView
                android:layout_width="80dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_rail"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="5dp">

            <LinearLayout
                android:id="@+id/nav_game"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play"
                    app:tint="@color/rail_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Игра"
                    android:textColor="@color/rail_item"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nav_mods"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_extension"
                    app:tint="@color/rail_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Моды"
                    android:textColor="@color/rail_item"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nav_log"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_log"
                    app:tint="@color/rail_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Лог"
                    android:textColor="@color/rail_item"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <View android:layout_width="28dp" android:layout_height="1dp" android:layout_gravity="center_horizontal" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="@color/bear_line" />
            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/rail_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Настройки"
                    android:textColor="@color/rail_item"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/nav_help"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_help"
                    app:tint="@color/rail_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Помощь"
                    android:textColor="@color/rail_item"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <View android:layout_width="28dp" android:layout_height="1dp" android:layout_gravity="center_horizontal" android:layout_marginTop="3dp" android:layout_marginBottom="3dp" android:background="@color/bear_line" />
            <LinearLayout
                android:id="@+id/nav_exit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="1dp"
                android:background="@drawable/bg_rail_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_exit"
                    app:tint="@color/rail_item" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Выход"
                    android:textColor="@color/rail_item"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include
                    android:id="@+id/page_game"
                    layout="@layout/page_game" />

                <include
                    android:id="@+id/page_mods"
                    layout="@layout/page_mods" />

                <include
                    android:id="@+id/page_log"
                    layout="@layout/page_log" />

                <include
                    android:id="@+id/page_settings"
                    layout="@layout/page_settings" />

                <include
                    android:id="@+id/page_help"
                    layout="@layout/page_help" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
    </com.bearite.patcher.DesignFrame>
</FrameLayout>
